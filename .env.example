VOLTEO_STORAGE=supabase
# Public browser configuration is already supplied in src/supabase-config.json.
# To target a different project, change that file and rebuild (server CSP reads it too).
# Never put a Supabase secret or service_role key in VITE_* variables.
VOLTEO_ORIGIN=http://localhost:5173
VOLTEO_PORT=8080
VOLTEO_SECURE_COOKIE=0

# SEO / acquisition (public identifiers, never a secret key)
VITE_SITE_URL=
# Set true on production once the canonical domain is known.
SEO_REQUIRE_ORIGIN=false
VITE_GA4_ID=
VITE_GOOGLE_ADS_ID=
VITE_GOOGLE_ADS_LEAD_LABEL=
